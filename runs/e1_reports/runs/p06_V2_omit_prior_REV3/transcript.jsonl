ge; sample=all; outcome=level; trim=1%\"\n}firm_id,supplier_diversity,export_growth_2023,log_sales_2020,years_exporting_2020,export_growth_2020,buyer_rating_2023,region,listed,product_group,inventory_days_2020,foreign_owned,share_imported_inputs_2020,port_distance_km,certified_iso,debt_ratio_2020\n1,1.0044,101.949,0.252,0.6529,2.302,0.9618,south,0,durables,-0.7981,1.0,-0.989,0.0,1.1238,-1.0289\n2,0.282,114.442,-0.2687,1.1098,0.5857,0.494,north,0,durables,1.8897,0.0,-0.3515,0.0,-0.4159,0.3489\nanalysis.py","is_error":false}]},"parent_tool_use_id":null,"session_id":"238221c5-97c0-4273-a556-3f7652028c79","uuid":"6a9de9cd-32ce-4977-95c1-affcc8d50c06"}
