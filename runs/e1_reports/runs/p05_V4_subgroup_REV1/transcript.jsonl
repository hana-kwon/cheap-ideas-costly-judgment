{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RHiyRKTiDumjeJTSz1bd8o","type":"tool_result","content":"import pandas as pd\nimport statsmodels.api as sm\n\ndf = pd.read_csv(\"data.csv\")\ndf = df[df['region'] == 'central']\ny = df[\"patents_per_100_eng_2023\"]\nlo, hi = y.quantile([0.01, 0.99])\ndf = df[(y >= lo) & (y <= hi)]\nX = sm.add_constant(df[['remote_share', 'log_engineers_2020', 'firm_age_2020', 'patents_per_100_eng_2020']].astype(float))\nfit = sm.OLS(df[\"patents_per_100_eng_2023\"].values, X.values).fit(cov_type=\"HC1\")\nprint(\"n =\", len(df))\nprint(\"coef =\", fit.params[1], \"se =\", fit.bse[1], \"p =\", fit.pvalues[1])","is_error":false}]},"parent_tool_use_id":null,"session_id":"86e78b78-8424-4a39-933d-8fb03c6b6414","uuid":"3699928e-3064-4065-ab04-eb7bcb5d452a"}
