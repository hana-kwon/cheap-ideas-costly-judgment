9ZrgMLFtW","tool_input":{"command":"cat > a.py <<'E'\nimport pandas as pd, statsmodels.formula.api as smf\ndf=pd.read_csv(\"data.csv\")\nprint(df.isna().sum().sum())\nbase=\"export_growth_2023 ~ supplier_diversity\"\npre=\"+log_sales_2020+years_exporting_2020+export_growth_2020\"\nallp=pre+\"+inventory_days_2020+foreign_owned+share_imported_inputs_2020+port_distance_km+certified_iso+debt_ratio_2020+C(region)+listed+C(product_group)\"\nfor n,f in [(\"none\",base),(\"pre\",base+pre),(\"all\",base+allp),(\"all+collider\",base+allp+\"+buyer_rating_2023\")]:\n    for d,l in [(df,\"full\")]:\n        r=smf.ols(f,d).fit(cov_type=\"HC1\");print(n,l,r.params['supplier_diversity'],r.pvalues['supplier_diversity'])\nprint(df.describe().T)\nprint(df[['supplier_diversity','inventory_days_2020','foreign_owned','share_imported_inputs_2020','port_distance_km','certified_iso','debt_ratio_2020','log_sales_2020','export_growth_2020','buyer_rating_2023','export_growth_2023']].corr().round(2))\nE\npython3 a.py"}}],"uuid":"139cae83-a803-498f-b4d5-04a9b5d8caf9"}
