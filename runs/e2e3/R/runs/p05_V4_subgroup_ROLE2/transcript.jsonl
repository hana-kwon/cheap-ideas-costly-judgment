{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014q2t5XbrhcZ1ZXjsVCSAdU","type":"tool_result","content":"import pandas as pd\nimport statsmodels.api as sm\n\ndf = pd.read_csv(\"data.csv\")\ndf = df[df['region'] == 'central']\ny = df[\"patents_per_100_eng_2023\"]\nlo, hi = y.quantile([0.01, 0.99])\ndf = df[(y >= lo) & (y <= hi)]\nX = sm.add_constant(df[['remote_share', 'log_engineers_2020', 'firm_age_2020', 'patents_per_100_eng_2020']].astype(float))\nfit = sm.OLS(df[\"patents_per_100_eng_2023\"].values, X.values).fit(cov_type=\"HC1\")\nprint(\"n =\", len(df))\nprint(\"coef =\", fit.params[1], \"se =\", fit.bse[1], \"p =\", fit.pvalues[1])","is_error":false}]},"parent_tool_use_id":null,"session_id":"897ccbe6-401a-40f7-8144-e0e61d0f8dfa","uuid":"e91afaca-a7fa-4deb-b013-058ea5114d99"}
