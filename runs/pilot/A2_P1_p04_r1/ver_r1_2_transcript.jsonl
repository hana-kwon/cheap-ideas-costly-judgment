{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TsgPKh9Bopeqx9F2oQgfFy","type":"tool_result","content":"import pandas as pd, numpy as np, statsmodels.formula.api as smf\nd=pd.read_csv('data.csv')\nprint(d.describe().T); print(d.isna().sum().sum())\npre=\"log_employees_2020+firm_age_2020+productivity_2020+C(region)+listed+C(sector)+export_share_2020+foreign_owned+family_owned+rd_intensity_2020+union_share_2020+credit_score_2020\"\nspecs={\n'naive':'productivity_2023~training_hours',\n'lagged_prod':'productivity_2023~training_hours+productivity_2020',\n'size_age_sector_region':'productivity_2023~training_hours+productivity_2020+log_employees_2020+firm_age_2020+C(region)+C(sector)+listed',\n'full_pre':'productivity_2023~training_hours+'+pre,\n'full_pre_plus_mgmt':'productivity_2023~training_hours+mgmt_rating_2023+'+pre,\n'naive_plus_mgmt':'productivity_2023~training_hours+mgmt_rating_2023',\n'full_pre_quad':'productivity_2023~training_hours+I(training_hours**2)+'+pre,\n'log_outcome_full':'np.log(productivity_2023)~training_hours+'+pre,\n}\nfor k,f in specs.items():\n    m=smf.ols(f,d).fit(cov_type='HC1')\n    print(k,round(m.params['training_hours'],4),round(m.bse['training_hours'],4),m.pvalues['training_hours'],len(m.resid))\nprint(d[['training_hours','mgmt_rating_2023','productivity_2020','productivity_2023']].corr())\nprint(smf.ols('training_hours~'+pre,d).fit().summary().tables[1])\nfirm_id,training_hours,productivity_2023,log_employees_2020,firm_age_2020,productivity_2020,mgmt_rating_2023,region,listed,sector,export_share_2020,foreign_owned,family_owned,rd_intensity_2020,union_share_2020,credit_score_2020\n1,-0.4401,104.208,-0.0789,0.4225,0.416,-2.1325,south,0,manufacturing,1.0089,1.0,-0.1368,1.0,2.0823,0.6401\n2,-1.2295,80.445,-0.4239,-0.6573,0.6865,-4.444,central,0,manufacturing,-2.0889,0.0,-0.5843,0.0,1.3929,-2.1318","is_error":false}]},"parent_tool_use_id":null,"session_id":"d0cb47a9-eec0-4763-a408-6e439c19c4b3","uuid":"920dafd6-e797